<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- See docs/adr/0004-security-model.md -->
    <record id="module_category_room_booking" model="ir.module.category">
        <field name="name">Room Booking</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_booking_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_room_booking"/>
    </record>

    <record id="group_booking_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_room_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_booking_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Every internal user is a Booking User automatically. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_booking_user'))]"/>
    </record>
</odoo>
